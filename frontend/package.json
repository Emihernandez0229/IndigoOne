{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron": "wait-on http://localhost:5173 && electron .",
    "dev:electron": "concurrently -k \"npm run dev\" \"npm run electron\""
  },
  "dependencies": {
